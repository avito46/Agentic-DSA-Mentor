# DSA Mentor AI - Environment Configuration Example
# Copy this file to .env and fill in your values.

# LeetCode Public Username (Public GraphQL profile only - NO passwords, NO cookies, NO session tokens)
LEETCODE_USERNAME=

# Local Ollama AI Settings (No cloud API, zero recurring fees)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT_SECONDS=15

# Telegram Bot (Optional - for daily notification dispatch)
TELEGRAM_BOT_TOKEN=9112710947:AAFQAK1OhjKGZAFRl5bUsL7LU_etgMD6I50
TELEGRAM_CHAT_ID=2019560767

# Scheduling & Timezone (Display and schedule in Asia/Kolkata, store in UTC)
TIMEZONE=Asia/Kolkata
DAILY_RUN_HOUR=8
DAILY_RUN_MINUTE=0

# Difficulty Preferences (Comma-separated: Easy, Medium, Hard - e.g. Medium,Hard)
PREFERRED_DIFFICULTIES=Medium,Hard

# Database & Storage
DB_PATH=database/dsa_mentor.db
SNAPSHOT_DIR=data/snapshots
CATALOGUE_PATH=data/problems.json

# API Server
API_HOST=127.0.0.1
API_PORT=5000
